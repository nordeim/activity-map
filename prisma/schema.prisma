// ROAM — Augsburg City Guide
// Prisma schema (SQLite). Mirrors the domain model of the reference app:
// login users, places (eat / stay / do), saved places (favourites), bookings.
//
// Field names follow the reference app's entity API (Eat / Stay / Do /
// SavedPlace / User) so the seed data captured from the live app maps 1:1:
//   category     "eat" | "stay" | "do"
//   subCategory  e.g. "Modern Bavarian", "5-star Stay", "Nature Walk"
//   vibeTags / cuisineTags / amenities / roomTypes / highlights / galleryImages
//                stored as JSON arrays (SQLite has no native array type)
//   priceRange   1..4  → €, €€, €€€, €€€€
//   nightlyPrice stay: price per night
//   price        do: ticket price (0 = free)
//   lat / lng    generated deterministically per neighborhood (see seed.ts)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarColor  String   @default("#996CE4")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  savedPlaces SavedPlace[]
  bookings    Booking[]
}

model Place {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  category         String // eat | stay | do
  subCategory      String?
  shortDescription String?
  description      String?
  coverImageUrl    String?
  galleryImages    String? // JSON array of urls
  priceRange       Float? // 1..4 → €..€€€€
  price            Float? // do: ticket price
  priceLabel       String? // do: display label e.g. "Free", "€12"
  nightlyPrice     Float? // stay: per-night price
  currency         String   @default("EUR")
  avgRating        Float    @default(0)
  reviewCount      Int      @default(0)
  isBookable       Boolean  @default(false)
  neighborhood     String?
  address          String?
  openingHours     String? // eat/do: e.g. "12:00–23:00"
  durationMin      Int? // do: minutes
  minParty         Int?
  maxParty         Int?
  vibeTags         String? // JSON array
  cuisineTags      String? // JSON array
  amenities        String? // JSON array (stay)
  roomTypes        String? // JSON array (stay)
  highlights       String? // JSON array (do)
  tags             String? // JSON array (do)
  status           String   @default("published")
  lat              Float?
  lng              Float?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  savedBy  SavedPlace[]
  bookings Booking[]

  @@index([category])
  @@index([neighborhood])
}

model SavedPlace {
  id        String   @id @default(cuid())
  userId    String
  placeId   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId])
}

model Booking {
  id        String   @id @default(cuid())
  userId    String
  placeId   String
  startDate DateTime?
  endDate   DateTime?
  guests    Int      @default(2)
  status    String   @default("confirmed") // confirmed | cancelled
  // Booking-request fields (session 3 parity — the live app's request form):
  name      String?
  surname   String?
  time      String?
  phone     String?
  email     String?
  message   String?
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([userId])
}
